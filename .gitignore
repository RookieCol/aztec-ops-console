# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# base de datos local (se regenera con pnpm db:reset)
/data/

# estado interno del harness de Claude Code, no del proyecto
/.claude/

# notas internas de trabajo (no van al repo publico)
/PLAN.md
/PLAN-EJECUCION.md
/DATASET-HALLAZGOS.md
